# =============================================================================
# Dockerfile for Streamlit Dashboard
# =============================================================================
# Runs the Streamlit dashboard for churn prediction visualization.
# Includes full pipeline dependencies so the "Run Pipeline" button on
# the Demo page can execute the ML pipeline inside this container.
# Exposes port 8501 (Streamlit default).
# =============================================================================

FROM python:3.10-slim

LABEL maintainer="churn-prediction-team"
LABEL description="Streamlit churn prediction dashboard"

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        libgomp1 \
        && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install the full pipeline requirements so that the dashboard can
# run `python -m src.main --mode all` directly inside this container.
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --timeout 180 --retries 10 -r requirements.txt

# cryptography pin shared with Dockerfile.pipeline
RUN pip install --no-cache-dir --timeout 180 --retries 10 cryptography==42.0.8

# Copy application source code
COPY src/ /app/src/
COPY config/ /app/config/
COPY scripts/ /app/scripts/

# Create directories for data and pipeline output
RUN mkdir -p /app/data /app/output /app/results /app/models /app/mlflow

# Set Python path so src modules are importable
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose Streamlit port
EXPOSE 8501

# Health check for Streamlit
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run Streamlit dashboard.
CMD ["streamlit", "run", "src/dashboard/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.runOnSave=true", \
     "--server.fileWatcherType=poll"]
